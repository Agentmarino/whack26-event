# app/frontend/.env (gitignored). Copy this file to .env to change the defaults.
# true (default): the whole chat runs on the mock conversation from app/shared (no backend needed)
# false: calls /api, which Vite proxies to API_TARGET (the 113 backend)
VITE_USE_MOCK=true
# Where the Vite proxy sends /api (default http://localhost:8000)
API_TARGET=http://localhost:8000
